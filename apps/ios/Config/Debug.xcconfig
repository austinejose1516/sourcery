// Debug — points at the deployed Cloudflare Workers API (live since the
// Railway→Cloudflare migration). Works from anywhere (no local server needed).
// NOTE: /voice/live returns 501 on Workers until the Durable Object port —
// for voice testing, uncomment the LAN URL below and run `pnpm dev` in apps/api.
#include "Base.xcconfig"

API_URL = https:/$()/recipeer-api.austinejose1516.workers.dev

// Local API on the Mac's LAN IP (phone + Mac on the same Wi-Fi, `pnpm dev` running):
// API_URL = http:/$()/192.168.68.55:8787

