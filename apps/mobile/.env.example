# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app bundle.
# Both values below are client-safe (publishable). Never put the Supabase
# secret key or DB password here — those stay server-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Base URL of the Hono API (apps/api). Optional — defaults to http://localhost:8787,
# which works for the iOS simulator. For a physical device, set your Mac's LAN IP,
# e.g. http://192.168.1.42:8787 (run `ipconfig getifaddr en0` to find it).
# EXPO_PUBLIC_API_URL=http://localhost:8787
