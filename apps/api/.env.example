# The API reads the repo-root .env first, then this file (apps/api/.env) as an
# override. Keep secrets out of git — root .env and apps/api/.env are gitignored.

# --- Supabase Postgres (Prisma) ---
# Find this in Supabase → Settings → Database → Connection string → URI
# Use the direct connection (port 5432) — required for Prisma migrations.
SUPABASE_DIRECT_URL=

# --- Supabase Auth (JWT verification) ---
# The project URL, e.g. https://xxx.supabase.co. Used to fetch the JWKS and to
# validate the token issuer. Required by lib/auth.ts.
SUPABASE_URL=

# --- Cloudflare R2 (S3-compatible) ---
# Already present in root .env:
BUCKET_NAME=
CLOUDFLARE_ACCOUNT_ID=
# Create an R2 API token (Cloudflare → R2 → Manage R2 API Tokens) and paste the
# Access Key ID + Secret Access Key it shows. These are NOT the Cloudflare API key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Recipe extraction: set ONE. Google AI Studio takes priority. ---

# Google AI Studio (preferred). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override if you want a specific Flash version (e.g. gemini-3.5-flash).
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash

# --- YouTube channel import (POST /youtube/*) ---
# Google Cloud → APIs & Services → Credentials → OAuth client ID → "Web application".
# NOT an iOS client: the code-for-token exchange runs server-side so the secret
# never ships in the app bundle. Enable "YouTube Data API v3" on the same project.
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI on that OAuth client, or Google
# rejects the flow with redirect_uri_mismatch. Set the Railway URL in production.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/youtube/oauth/callback

# AES-256-GCM key for refresh tokens at rest. Generate with:
#   openssl rand -base64 32
# Rotating this orphans every stored token and forces all users to reconnect.
YOUTUBE_TOKEN_ENC_KEY=

# PORT=8787
