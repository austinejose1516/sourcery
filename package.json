{
  "name": "recipeer",
  "private": true,
  "version": "0.0.1",
  "description": "Malayalam cooking videos → structured English recipes",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "pnpm --filter api dev",
    "api:start": "pnpm --filter api start",
    "mobile": "pnpm --filter mobile start",
    "mobile:web": "pnpm --filter mobile run web",
    "ios": "pnpm --filter mobile exec expo run:ios --device",
    "ios:release": "pnpm --filter mobile exec expo run:ios --device --configuration Release",
    "ios:sim": "pnpm --filter mobile exec expo run:ios",
    "typecheck": "pnpm -r run typecheck"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.85.3"
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "~56.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
