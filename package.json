{
  "name": "recipeer",
  "private": true,
  "version": "0.0.1",
  "description": "Malayalam cooking videos → structured English recipes",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "pnpm --filter api dev",
    "api:start": "pnpm --filter api start",
    "ios": "xcodebuild -project apps/ios/ReciPeer.xcodeproj -scheme ReciPeer -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 17' build",
    "ios:release": "xcodebuild -project apps/ios/ReciPeer.xcodeproj -scheme ReciPeer -configuration Release -destination 'generic/platform=iOS' build",
    "ios:project": "open apps/ios/ReciPeer.xcodeproj",
    "trigger:dev": "pnpm --filter api run trigger:dev",
    "trigger:deploy": "pnpm --filter api run trigger:deploy",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
